{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "services/relay/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["services/relay/sql/init.sql"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/services/relay/api/index.ts"
    }
  ]
}
