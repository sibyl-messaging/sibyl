{
  "name": "@sibyl/relay",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:protocol": "tsc -p ../../packages/protocol/tsconfig.json",
    "build": "npm run build:protocol && tsc -p tsconfig.json",
